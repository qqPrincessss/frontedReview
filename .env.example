# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/codereview_ai?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-change-this"
JWT_EXPIRES_IN="24h"

# Anthropic (Claude AI)
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-5-20250929"

# PDF（可选；未配置时会自动查找常见系统中文字体）
PDF_FONT_PATH=""

# Server
PORT=3000
NODE_ENV=development
