# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/codereview_ai?schema=public"

# Anthropic
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="your-anthropic-model-id"
ANTHROPIC_TIMEOUT_MS=60000
ANTHROPIC_MAX_RETRIES=2

# JWT
JWT_SECRET="your-jwt-secret-change-this"
JWT_EXPIRES_IN="24h"

# PDF（可选；未配置时会自动查找常见系统中文字体）
PDF_FONT_PATH=""

# Server
PORT=3000
NODE_ENV=development
